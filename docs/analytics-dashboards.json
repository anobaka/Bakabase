                  "math_hogql": "uniq(properties.deployment_id)"
                }
              ],
              "trendsFilter": {
                "display": "ActionsLineGraph",
                "showLegend": true
              }
            }
          },
          "layout": {
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 5
