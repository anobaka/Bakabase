    {
      "key": "adoption",
      "name": "Bakabase v2 · 功能采用",
      "description": "曝光、尝试与成功是不同指标；采用率分母限定为同一功能已曝光客户端。 仅 schema_version=2、production；等待 v2 上线后有数据。定义为提案；UV 是匿名客户端，不是真人数。",
      "insights": [
        {
          "key": "exposure",
          "name": "Web 功能曝光客户端",
          "description": "30 天内 feature_exposed 的匿名客户端，按 feature_id；曝光表示入口/界面出现，不等于实际使用。移动端尚无对应曝光事件。",
          "query": {
            "kind": "InsightVizNode",
            "source": {
              "kind": "TrendsQuery",
              "dateRange": {
                "date_from": "-30d"
              },
              "interval": "day",
              "properties": [
                {
                  "key": "schema_version",
                  "value": 2,
                  "operator": "exact",
                  "type": "event"
                },
                {
                  "key": "environment",
                  "value": "production",
                  "operator": "exact",
                  "type": "event"
                },
                {
                  "key": "actor_type",
                  "value": "client",
                  "operator": "exact",
                  "type": "event"
                }
              ],
              "series": [
                {
                  "kind": "EventsNode",
                  "event": "feature_exposed",
                  "name": "feature_exposed",
                  "custom_name": "曝光客户端",
                  "math": "hogql",
                  "math_hogql": "uniq(distinct_id)"
                }
              ],
              "trendsFilter": {
                "display": "ActionsBarValue",
                "showLegend": true
