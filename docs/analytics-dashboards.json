                {
                  "key": "environment",
                  "value": "production",
                  "operator": "exact",
                  "type": "event"
                },
                {
                  "key": "actor_type",
                  "value": "client",
                  "operator": "exact",
                  "type": "event"
                }
              ],
              "series": [
                {
                  "kind": "EventsNode",
                  "custom_name": "交互客户端",
                  "math": "hogql",
