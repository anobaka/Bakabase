    {
      "key": "versions",
      "name": "Bakabase v2 · 版本与部署",
      "description": "每部署/客户端仅取窗口内最新观察值，避免频繁上报或升级导致重复加权。 仅 schema_version=2、production；等待 v2 上线后有数据。定义为提案；UV 是匿名客户端，不是真人数。",
      "insights": [
        {
          "key": "server_versions",
          "name": "服务端版本与部署类型 · 近 30 天最新",
          "description": "每 deployment_id 最近一次心跳对应的 server_version / deployment_type / release_channel；统计近 30 天被观察到的部署，不是所有安装量。",
          "query": {
            "kind": "DataVisualizationNode",
            "source": {
              "kind": "HogQLQuery",
              "query": "SELECT server_version, deployment_type, release_channel, count() AS deployments FROM (SELECT properties.deployment_id AS deployment_id, argMax(properties.server_version, timestamp) AS server_version, argMax(properties.deployment_type, timestamp) AS deployment_type, argMax(properties.release_channel, timestamp) AS release_channel FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND toFloat(properties.schema_version) = 2 AND properties.environment = 'production' AND event = 'runtime_heartbeat' GROUP BY deployment_id) GROUP BY server_version, deployment_type, release_channel ORDER BY deployments DESC LIMIT 100"
            },
            "display": "ActionsTable"
          },
          "layout": {
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 5
          }
        },
        {
          "key": "client_versions",
          "name": "客户端版本与界面 · 近 30 天最新",
          "description": "每客户端最后一次前端观察的 client_version 和 client_surface。排除后端关联事件缺少 client_version 的记录；Web 资产版本不应被当作远端 server_version。",
          "query": {
            "kind": "DataVisualizationNode",
            "source": {
              "kind": "HogQLQuery",
              "query": "SELECT client_version, client_surface, count() AS clients FROM (SELECT distinct_id, argMax(properties.client_version, timestamp) AS client_version, argMax(properties.client_surface, timestamp) AS client_surface FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND toFloat(properties.schema_version) = 2 AND properties.environment = 'production' AND properties.actor_type = 'client' AND properties.client_version IS NOT NULL GROUP BY distinct_id) GROUP BY client_version, client_surface ORDER BY clients DESC LIMIT 100"
            },
            "display": "ActionsTable"
          },
          "layout": {
            "x": 6,
            "y": 0,
            "w": 6,
            "h": 5
          }
        },
        {
          "key": "server_platform",
          "name": "服务端 OS / 架构 · 近 30 天最新",
          "description": "每 deployment_id 最新心跳的平台，不能与客户端 OS 混用。只统计近 30 天有观察的实例。",
          "query": {
            "kind": "DataVisualizationNode",
            "source": {
              "kind": "HogQLQuery",
              "query": "SELECT server_os, server_arch, count() AS deployments FROM (SELECT properties.deployment_id AS deployment_id, argMax(properties.server_os, timestamp) AS server_os, argMax(properties.server_arch, timestamp) AS server_arch FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND toFloat(properties.schema_version) = 2 AND properties.environment = 'production' AND event = 'runtime_heartbeat' GROUP BY deployment_id) GROUP BY server_os, server_arch ORDER BY deployments DESC LIMIT 100"
            },
            "display": "ActionsTable"
          },
          "layout": {
            "x": 0,
            "y": 5,
            "w": 6,
            "h": 5
          }
        },
        {
          "key": "library_size",
          "name": "本地主库规模 · 近 7 天最新可用快照",
          "description": "每部署最近一次 snapshot_status=ok 的本地主库 resource_count；只看近 7 天。远端副本不重复计入；退出/离线实例可能短期保留。",
          "query": {
            "kind": "DataVisualizationNode",
            "source": {
              "kind": "HogQLQuery",
              "query": "SELECT multiIf(resource_count = 0, '0', resource_count < 100, '1-99', resource_count < 1000, '100-999', resource_count < 10000, '1000-9999', '10000+') AS resource_bucket, count() AS deployments FROM (SELECT properties.deployment_id AS deployment_id, argMax(toFloat(properties.resource_count), timestamp) AS resource_count FROM events WHERE timestamp >= now() - INTERVAL 7 DAY AND toFloat(properties.schema_version) = 2 AND properties.environment = 'production' AND event = 'deployment_snapshot' AND properties.snapshot_status = 'ok' GROUP BY deployment_id) GROUP BY resource_bucket ORDER BY resource_bucket LIMIT 20"
            },
            "display": "ActionsBarValue",
            "chartSettings": {
              "xAxis": {
                "column": "resource_bucket"
              },
              "yAxis": [
                {
                  "column": "deployments"
                }
              ]
            }
          },
          "layout": {
            "x": 6,
            "y": 5,
            "w": 6,
            "h": 5
          }
        }
      ],
      "live_dashboard_url": "https://eu.posthog.com/project/175495/dashboard/1042017"
    },
    {
      "key": "activity",
      "name": "Bakabase v2 · 活跃与留存",
      "description": "活跃=资源打开、真实消费、功能操作或用户查询；启动/心跳/页面曝光不进入核心活跃。 仅 schema_version=2、production；等待 v2 上线后有数据。定义为提案；UV 是匿名客户端，不是真人数。",
      "insights": [
        {
          "key": "dau",
          "name": "核心交互 DAU · 匿名客户端",
          "description": "每天 uniq(distinct_id)，仅 client 的明确交互集合；查询只计 manual+replace，启动、恢复、刷新、分页和系统任务排除。一台客户端不等于一个真人。",
          "query": {
            "kind": "InsightVizNode",
            "source": {
              "kind": "TrendsQuery",
              "dateRange": {
                "date_from": "-30d"
              },
              "interval": "day",
              "properties": [
                {
                  "key": "schema_version",
                  "value": 2,
                  "operator": "exact",
                  "type": "event"
                },
                {
                  "key": "environment",
                  "value": "production",
                  "operator": "exact",
                  "type": "event"
                },
                {
                  "key": "actor_type",
                  "value": "client",
                  "operator": "exact",
                  "type": "event"
                }
              ],
              "series": [
                {
                  "kind": "EventsNode",
                  "custom_name": "交互客户端",
                  "math": "hogql",
                  "math_hogql": "uniq(distinct_id)",
                  "properties": [
                    {
                      "type": "hogql",
                      "key": "(event IN ('resource_opened','playback_started','reader_opened','feature_invoked','client_action_completed') OR (event = 'resource_query_presented' AND (properties.search_kind = 'manual' AND properties.load_mode = 'replace')))"
                    }
                  ]
                }
              ],
              "trendsFilter": {
                "display": "ActionsLineGraph",
                "showLegend": true
              }
            }
          },
          "layout": {
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 5
          }
        },
        {
          "key": "wau_mau",
          "name": "近 1 / 7 / 30 天交互客户端",
          "description": "固定滚动 24h / 7d / 30d 的客户端去重数；不能把每日 DAU 相加求 WAU/MAU。范围与核心交互 DAU 相同。",
          "query": {
            "kind": "DataVisualizationNode",
            "source": {
              "kind": "HogQLQuery",
              "query": "SELECT uniqIf(distinct_id, timestamp >= now() - INTERVAL 1 DAY) AS active_clients_24h, uniqIf(distinct_id, timestamp >= now() - INTERVAL 7 DAY) AS active_clients_7d, uniq(distinct_id) AS active_clients_30d FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND toFloat(properties.schema_version) = 2 AND properties.environment = 'production' AND properties.actor_type = 'client' AND (event IN ('resource_opened','playback_started','reader_opened','feature_invoked','client_action_completed') OR (event = 'resource_query_presented' AND (properties.search_kind = 'manual' AND properties.load_mode = 'replace'))) LIMIT 1"
            },
            "display": "ActionsTable"
          },
          "layout": {
            "x": 6,
            "y": 0,
            "w": 6,
            "h": 5
          }
        },
        {
          "key": "retention",
          "name": "资源打开留存 · 每日周期 cohort",
          "description": "原生 recurring retention：当日 resource_opened 客户端在第 1–7 个日历日再次打开资源；非首装留存、非累计回访。UTC；未成熟 cohort 不作 0% 解读。",
          "query": {
            "kind": "InsightVizNode",
            "source": {
              "kind": "RetentionQuery",
              "dateRange": {
                "date_from": "-30d"
              },
              "properties": [
                {
                  "key": "schema_version",
                  "type": "event",
                  "operator": "exact",
                  "value": 2
                },
                {
                  "key": "environment",
                  "type": "event",
                  "operator": "exact",
                  "value": "production"
                },
                {
                  "key": "actor_type",
                  "type": "event",
                  "operator": "exact",
                  "value": "client"
                }
              ],
              "retentionFilter": {
                "targetEntity": {
                  "id": "resource_opened",
                  "type": "events"
                },
                "returningEntity": {
                  "id": "resource_opened",
                  "type": "events"
                },
                "period": "Day",
                "totalIntervals": 8,
                "retentionType": "retention_recurring",
                "cumulative": false,
                "timeWindowMode": "strict_calendar_dates",
                "meanRetentionCalculation": "weighted"
              }
            }
          },
          "layout": {
            "x": 0,
            "y": 5,
            "w": 6,
            "h": 5
          }
        },
        {
          "key": "surfaces",
