          "layout": {
            "x": 0,
            "y": 0,
            "w": 6,
            "h": 5
          }
        },
        {
          "key": "attempt_rate",
          "name": "Web 功能尝试率 · 近 30 天",
          "description": "同 feature_id 同窗口同时有 exposed 与 invoked 的客户端 / exposed 客户端；尝试不是业务成功，也不强制时间先后。零分母显示空值。",
          "query": {
            "kind": "DataVisualizationNode",
            "source": {
              "kind": "HogQLQuery",
              "query": "SELECT feature_id, countIf(exposed > 0) AS exposed_clients, countIf(exposed > 0 AND invoked > 0) AS attempted_exposed_clients, countIf(exposed > 0 AND invoked > 0) / nullIf(countIf(exposed > 0), 0) AS attempt_rate FROM (SELECT distinct_id, properties.feature_id AS feature_id, countIf(event = 'feature_exposed') AS exposed, countIf(event = 'feature_invoked') AS invoked FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND toFloat(properties.schema_version) = 2 AND properties.environment = 'production' AND properties.actor_type = 'client' AND event IN ('feature_exposed','feature_invoked') GROUP BY distinct_id, feature_id) GROUP BY feature_id ORDER BY exposed_clients DESC LIMIT 100"
            },
            "display": "ActionsTable"
          },
          "layout": {
            "x": 6,
            "y": 0,
            "w": 6,
            "h": 5
          }
        },
        {
          "key": "completed_features",
          "name": "已成功的配置与编辑 · 客户端数",
          "description": "30 天后端权威 outcome=success 结果的去重客户端。一次配置成功不代表该功能持续使用；自动/system 事件排除。",
          "query": {
