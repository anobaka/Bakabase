          "description": "按 provider_type / ai_feature / outcome 统计真实请求，缓存命中排除。duration p95 单位 ms。token 仅统计提供用量的样本；缺失不是零，不据此估算账单。",
          "query": {
            "kind": "DataVisualizationNode",
            "source": {
              "kind": "HogQLQuery",
              "query": "SELECT properties.provider_type AS provider_type, properties.ai_feature AS ai_feature, properties.outcome AS outcome, count() AS requests, quantile(0.95)(toFloat(properties.duration_ms)) AS duration_p95_ms, countIf(properties.token_usage_available = 'true') AS requests_with_token_usage, sumIf(toFloat(properties.total_tokens), properties.token_usage_available = 'true') AS reported_total_tokens FROM events WHERE timestamp >= now() - INTERVAL 30 DAY AND toFloat(properties.schema_version) = 2 AND properties.environment = 'production' AND event = 'ai_request_completed' GROUP BY provider_type, ai_feature, outcome ORDER BY requests DESC LIMIT 100"
