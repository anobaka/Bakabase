{
  "schema_version": 2,
  "identity_version": 2,
  "definition_status": "proposed",
  "owner_tag": "bakabase-analytics-v2",
  "notes": [
    "These definitions are repository-owned proposals, not approved catalog metrics. Every query is restricted to production schema_version=2.",
    "No production v2 events existed during creation on 2026-10-21. Empty charts are expected until rollout and consent.",
    "Anonymous clients are not people: shared clients merge people; multiple clients, browser storage resets and reinstalls split people. No identity aliasing across v1/v2.",
    "Native retention and funnels use PostHog's deterministic personless actor for the stable v2:client UUID. This equals client grain only while v2 IDs are never identified/aliased/merged. No person property or group filters.",
    "Trends/retention/funnels use insight date ranges; custom SQL explicitly fixes 7/30 day windows as named. Dashboard date overrides do not rewrite custom SQL.",
    "Missing telemetry is not proof of downtime. Heartbeats, opt-outs, offline delivery loss, and disabled development environments limit coverage.",
    "Standard counts are observations/attempts, not installs or unique jobs. Native funnels are ordered within 30 minutes per anonymous client, not tied to one resource or operation.",
    "Backend search completion counts API requests including automatic loading/pagination; UI manual search across web/mobile filters search_kind=manual and load_mode=replace, excluding restore/refresh/append.",
    "Task attempts may include retries and partial/waiting states; rates only concern collected attempts, excluding scheduled housekeeping. Provider request counts exclude cache hits.",
    "Never add unsanitized URLs, titles, resource IDs, prompts, keys, or identity properties to these charts."
  ],
  "documentation_sources": [
    "https://posthog.com/docs/product-analytics/funnels",
    "https://posthog.com/docs/product-analytics/retention",
    "https://github.com/PostHog/posthog/blob/master/docs/published/handbook/engineering/person-processing.md#personless-mode-anonymous-events"
  ],
  "dashboards": [
    {
      "key": "runtime",
      "name": "Bakabase v2 · 运行健康",
      "description": "观察启动、监听就绪与运行部署；心跳不等于精确 uptime，unclean_or_unknown 不等于崩溃。 仅 schema_version=2、production；等待 v2 上线后有数据。定义为提案；UV 是匿名客户端，不是真人数。",
      "insights": [
        {
          "key": "active_deployments",
          "name": "每日有心跳的部署",
          "description": "30 天内每天 uniq(deployment_id)。包括无人操作的后台部署；不是 DAU，也不推算精确在线时长。",
          "query": {
            "kind": "InsightVizNode",
            "source": {
              "kind": "TrendsQuery",
              "dateRange": {
                "date_from": "-30d"
              },
              "interval": "day",
              "properties": [
                {
                  "key": "schema_version",
                  "value": 2,
                  "operator": "exact",
                  "type": "event"
                },
                {
                  "key": "environment",
                  "value": "production",
                  "operator": "exact",
                  "type": "event"
                }
              ],
              "series": [
                {
                  "kind": "EventsNode",
                  "event": "runtime_heartbeat",
                  "name": "runtime_heartbeat",
                  "custom_name": "有心跳的部署",
