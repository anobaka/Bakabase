<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Deliberately not a copy of the all-in-one's plist. The bundle identifier is what
  macOS uses to tell two apps apart — for Launch Services, for defaults, and for the
  permissions the user grants (files, automation). Sharing com.anobaka.bakabase would
  make installing this replace the all-in-one in the user's eyes and break running
  both on one machine, which is a supported thing to do.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Bakabase Client</string>
    <key>CFBundleDisplayName</key>
    <string>Bakabase Client</string>
    <key>CFBundleIdentifier</key>
    <string>com.anobaka.bakabase.client</string>
    <key>CFBundleExecutable</key>
    <string>Bakabase.Client</string>
    <key>CFBundleVersion</key>
    <string>1.0.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>app.icns</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>10.15</string>
</dict>
</plist>
