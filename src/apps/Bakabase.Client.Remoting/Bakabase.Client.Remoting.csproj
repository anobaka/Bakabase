<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The legacy thin-client product: its host, connect page, updater, telemetry, tray
      bridge and the /client API that belongs to a window with exactly one server behind
      it. The relay itself — forwarding, signing, pairing, path mapping and the handlers
      that run a command on this machine — lives in Bakabase.Remoting, which the
      all-in-one composes too.

      The thin client is deprecated: the all-in-one manages other servers itself. This
      project goes away together with Bakabase.Client.App once the final client release
      has shipped its migration notice.

      Deliberately free of Avalonia and of Bakabase.Service, for the same reason as
      before: the shell talks to a host through IShellHost, and this project is what the
      client flavour puts behind it.
    -->
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!--
          Matches the project name, and deliberately differs from the entry project's
          Bakabase.Client: two assemblies cannot share a name, and that one is pinned by
          the shipped executable.
        -->
        <AssemblyName>Bakabase.Client.Remoting</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <!-- The relay, pairing, path mapping and user-machine handlers, shared with the
             all-in-one. What stays here is only what makes this the legacy thin-client
             product: its host, connect page, updater, telemetry and tray bridge. -->
        <ProjectReference Include="..\Bakabase.Remoting\Bakabase.Remoting.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!--
        Errors from this process. Not Sentry.AspNetCore: its diagnostic listener files an
        event per failed HTTP request, and every request this process handles is a relay
        to a server on somebody's LAN.
      -->
      <PackageReference Include="Sentry.Extensions.Logging" Version="4.13.0" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Flows into the entry project's output, where ClientHost adds it to the
          configuration by name. Deliberately not called appsettings.json: the test project
          references both this and Bakabase.Service, and two files with that name silently
          overwrite one another in the output — whichever copies last wins, and nothing
          warns.
        -->
        <Content Include="client-analytics.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- The connect page. Embedded so it cannot go missing from an install, and so
             nothing on disk can be swapped for a page that would run at this client's
             own origin with its /client API in reach. -->
        <EmbeddedResource Include="Assets\connect.html" />
    </ItemGroup>

</Project>
