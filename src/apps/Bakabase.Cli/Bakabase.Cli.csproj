<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>Bakabase.Cli</AssemblyName>
        <RootNamespace>Bakabase.Cli</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
      <ProjectReference Include="..\Bakabase.Service\Bakabase.Service.csproj" />
      <!-- Only for codegen: the relay's failure header (ClientForwardingFailure) is read
           by the same frontend, and this is the one project that can see both sides. -->
      <ProjectReference Include="..\Bakabase.Remoting\Bakabase.Remoting.csproj" />
    </ItemGroup>
</Project>
