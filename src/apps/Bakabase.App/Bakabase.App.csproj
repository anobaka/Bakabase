<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The desktop app's entry point: the process entry, the packaging inputs (icon,
      manifest, Info.plist) and the reference to Bakabase.Service, wrapped as an
      IShellHost. Everything visual lives in Bakabase.Shell.

      It also references Bakabase.Remoting, for the relays that let this window show and
      manage other servers (UnifiedHost adds them next to its own server).
    -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationIcon>..\Bakabase.Shell\Assets\favicon.ico</ApplicationIcon>
        <!--
          Stays Bakabase while the project is Bakabase.App: the shipped executable's
          name is recorded in every installed Velopack manifest, so renaming it would
          strand existing installs on the version they have.
        -->
        <AssemblyName>Bakabase</AssemblyName>
        <RootNamespace>Bakabase.App</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.20" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
        <PackageReference Include="HttpCloak" Version="1.6.1" />
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
        <PackageReference Include="Velopack" Version="1.2.0" />
        <PackageReference Include="Nerdbank.GitVersioning" Version="3.7.115">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bakabase.Shell\Bakabase.Shell.csproj" />
        <ProjectReference Include="..\Bakabase.Service\Bakabase.Service.csproj" />
        <ProjectReference Include="..\Bakabase.Remoting\Bakabase.Remoting.csproj" />
    </ItemGroup>

    <!-- Copy favicon.png to output for macOS Dock icon -->
    <ItemGroup>
        <None Include="..\Bakabase.Shell\Assets\dock-icon.png" CopyToOutputDirectory="PreserveNewest" Link="Assets\dock-icon.png" />
    </ItemGroup>

    <!-- Windows icon for Velopack packaging -->
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <None Include="..\Bakabase.Shell\Assets\favicon.ico" CopyToOutputDirectory="PreserveNewest" Link="Assets\favicon.ico" />
    </ItemGroup>

    <!-- macOS app bundle configuration -->
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <Content Include="Info.plist" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\Bakabase.Shell\Assets\app.icns" CopyToOutputDirectory="PreserveNewest" Link="Assets\app.icns" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <Target Name="CreateWwwRoot" AfterTargets="Publish">
        <Message Text="Try create wwwroot folder" Importance="high" />
        <MakeDir Directories="$(PublishDir)wwwroot" Condition="!Exists('$(PublishDir)wwwroot')" />
    </Target>
</Project>
