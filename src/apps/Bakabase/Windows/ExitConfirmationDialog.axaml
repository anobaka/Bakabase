<Window
    x:Class="Bakabase.Windows.ExitConfirmationDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Close Bakabase"
    Width="460"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    Icon="/Assets/favicon.png"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource ExitSurfaceBrush}"
    mc:Ignorable="d">

    <Window.Styles>
        <StyleInclude Source="avares://Bakabase/Styles/ExitStyles.axaml" />
    </Window.Styles>

    <DockPanel LastChildFill="True">

        <!--
            Action bar sits in its own tinted band so the buttons read as a footer rather
            than as more body content. DockPanel.Dock="Bottom" before the fill child is
            required: the last child of a DockPanel always fills.
        -->
        <Border
            Name="Footer"
            Classes="exit-footer"
            DockPanel.Dock="Bottom"
            Padding="24,16">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    Name="CancelBtn"
                    MinWidth="88"
                    Classes="exit-secondary"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"
                    Content="Cancel" />
                <Button
                    Name="ExitBtn"
                    MinWidth="88"
                    Classes="exit-secondary"
                    HorizontalContentAlignment="Center"
                    Content="Exit" />
                <Button
                    Name="MinimizeBtn"
                    MinWidth="140"
                    Classes="exit-primary"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    Content="Minimize to tray" />
            </StackPanel>
        </Border>

        <Grid Margin="24,24,24,20" RowDefinitions="Auto,Auto,Auto">

            <!-- Header: app mark + heading + one line of explanation. -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                <!--
                    favicon.png has no alpha channel, so on a dark background it would read as
                    a bare white square. Clipping it into a rounded tile with a hairline border
                    and a soft shadow turns that into a deliberate app mark in both themes.
                -->
                <Border
                    Grid.Column="0"
                    Width="44"
                    Height="44"
                    Margin="0,2,14,0"
                    Classes="exit-tile"
                    VerticalAlignment="Top">
                    <Image Source="/Assets/favicon.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock
                        Name="Heading"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        Text="Close Bakabase?"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Name="Subheading"
                        FontSize="13"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="Bakabase can keep running in the notification area so background tasks continue."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Shown only while tasks that would lose data are still running. -->
            <Border
                Name="BusyPanel"
                Grid.Row="1"
                Margin="0,18,0,0"
                Padding="14,12"
                Classes="exit-card"
                IsVisible="False">
                <Grid ColumnDefinitions="Auto,*">
                    <Path
                        Grid.Column="0"
                        Width="18"
                        Height="18"
                        Margin="0,1,10,0"
                        VerticalAlignment="Top"
                        Data="M12,3.2 L22.4,21 L1.6,21 Z M12,9.6 L12,15.4 M12,17.9 L12,18.1"
                        Stroke="{DynamicResource SystemControlErrorTextForegroundBrush}"
                        StrokeJoin="Round"
                        StrokeLineCap="Round"
                        StrokeThickness="1.7" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock
                            Name="BusyHeading"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                            Text="Background tasks are still running"
                            TextWrapping="Wrap" />
                        <StackPanel Name="BusyTaskList" Spacing="3" />
                        <TextBlock
                            Name="BusyBody"
                            FontSize="12"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Text="Exiting now interrupts them and unsaved changes may be lost."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel
                Name="RememberPanel"
                Grid.Row="2"
                Margin="0,18,0,0"
                Spacing="2">
                <CheckBox
                    Name="RememberCheckBox"
                    MinHeight="0"
                    Padding="8,0,0,0"
                    VerticalContentAlignment="Center"
                    FontSize="13"
                    Content="Remember my choice" />
                <TextBlock
                    Name="RememberHint"
                    Margin="30,0,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="You can change this later under Settings → Functional → Exit behavior."
                    TextWrapping="Wrap" />
            </StackPanel>

        </Grid>
    </DockPanel>
</Window>
