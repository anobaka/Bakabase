<Application
    x:Class="Bakabase.Shell.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://Bakabase.Shell/Assets/favicon.ico"
                      ToolTipText="Bakabase"
                      IsVisible="True">
                <TrayIcon.Menu>
                    <!--
                      Headers double as lookup keys in App.OnFrameworkInitializationCompleted.
                      TrayMenuController then localises them and, when the host can switch the
                      main window between servers, inserts a "Switch to" submenu after Open.
                    -->
                    <NativeMenu>
                        <NativeMenuItem Header="Open" />
                        <NativeMenuItem Header="Exit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
