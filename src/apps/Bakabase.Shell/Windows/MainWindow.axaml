<Window
    x:Class="Bakabase.Shell.Windows.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Bakabase.Shell.Controls;assembly=Bakabase.Shell"
    Icon="/Assets/favicon.png"
    Title="MainWindow"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <!--
          The tray's "Switch to" submenu, for desktops that show no tray. Hidden everywhere
          else; see MainWindow.SetServerSwitchMenu.
        -->
        <Menu Name="ServerSwitchBar" DockPanel.Dock="Top" IsVisible="False">
            <MenuItem Name="ServerSwitchRoot" />
        </Menu>
        <controls:NativeWebViewHost Name="WebView" />
    </DockPanel>
</Window>
