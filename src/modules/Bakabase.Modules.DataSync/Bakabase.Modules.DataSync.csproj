<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The data sync engine. Pure: no EF, ASP.NET, file I/O, Service, legacy, Property or Federation.
    Bakabase.Abstractions is its only reference (ProjectGraphTests checks the direct references).
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bakabase.Modules.DataSync.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../abstractions/Bakabase.Abstractions/Bakabase.Abstractions.csproj" />
  </ItemGroup>
</Project>
