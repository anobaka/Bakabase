<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.8" />
    <!-- First upstream release accepting hybrid torrents with final-file padding (MonoTorrent #688). -->
    <PackageReference Include="MonoTorrent" Version="3.0.3-alpha.unstable.rev0024" />
    <PackageReference Include="Downloader" Version="5.9.6" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bakabase.Tests" />
    <InternalsVisibleTo Include="Bakabase.Modules.Downloader.Tests" />
    <Content Include="ThirdPartyNotices/Downloader.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices/MonoTorrent.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
