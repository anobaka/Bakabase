<Project Sdk="MSTest.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\legacy\Bakabase.InsideWorld.Business\Bakabase.InsideWorld.Business.csproj" />
    <ProjectReference Include="..\..\apps\Bakabase.Remoting\Bakabase.Remoting.csproj" />
    <ProjectReference Include="..\..\apps\Bakabase.Service\Bakabase.Service.csproj" />
    <ProjectReference Include="..\Bakabase.TestKit\Bakabase.TestKit.csproj" />
    <!-- A second process for the single-instance tests (see SingleInstance/InstanceProbe.cs). -->
    <ProjectReference Include="..\Bakabase.Tests.InstanceProbe\Bakabase.Tests.InstanceProbe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sample shared content the acquisition tests read, kept as files so the same samples can
         be reused as more steps land. -->
    <Content Include="Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The scrubbed Bilibili fixtures live with the module tests; the legacy downloader tests read the same files. -->
    <Content Include="..\Bakabase.Modules.ThirdParty.Tests\Fixtures\Bilibili\**\*" LinkBase="Fixtures\Bilibili">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- One fake of the Bilibili wire (API, CDN, merger) for both suites, so they test the same protocol. -->
    <Compile Include="..\Bakabase.Modules.ThirdParty.Tests\Bilibili\Shared\*.cs" LinkBase="Bilibili\Shared" />
  </ItemGroup>

</Project>
