# Use a published explicit tag, or keep bakabase:local for source builds.
BAKABASE_IMAGE=bakabase:local
BAKABASE_DATA_DIR="${HOME}/BakabaseServer/appdata"
BAKABASE_BIND_ADDRESS=127.0.0.1
BAKABASE_PORT=34567
BAKABASE_NODE_NAME="Bakabase Server"
# Used by compose.local.yaml only. These host paths must already be mounted.
BAKABASE_MEDIA_ROOT_1=/Volumes/nas-bakabase
BAKABASE_MEDIA_ROOT_2=/Volumes/nas-anobaka
BAKABASE_IMPORT_DIR="${HOME}/Downloads/Bakabase"
