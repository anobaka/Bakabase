# Use a published explicit tag, or keep bakabase:local for source builds.
BAKABASE_IMAGE=bakabase:local
# Required: choose and create an absolute host directory before starting.
# Existing deployments must keep their current data directory.
# Example only: BAKABASE_DATA_DIR="/absolute/path/to/bakabase-data"
BAKABASE_DATA_DIR=
BAKABASE_BIND_ADDRESS=127.0.0.1
BAKABASE_PORT=34567
BAKABASE_NODE_NAME="Bakabase Server"
